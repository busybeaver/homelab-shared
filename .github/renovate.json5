{
  "extends": [
    "config:js-app",
    ":semanticCommits",
    ":semanticPrefixFixDepsChoreOthers",
    ":rebaseStalePrs",
    ":prHourlyLimit4",
    ":prConcurrentLimit10",
    ":maintainLockFilesWeekly",
    ":enableVulnerabilityAlerts",
    ":disableDependencyDashboard",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "labels": ["dependencies"],
  // supply-chain cooldown: an update waits until its release is old enough (default 3 days, per update type below);
  // with "strict" internal checks, Renovate creates no branch (and no CI run with the new dependency) before that
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  // no rollback PRs: they proposed downgrades whenever a datasource stopped listing a pinned version
  "rollbackPrs": false,
  "packageRules": [
    {
      "description": "Dependency maintenance tasks",
      "matchUpdateTypes": ["pin", "lockFileMaintenance"],
      "minimumReleaseAge": "0 days",
      "assignees": ["busybeaver"],
      "reviewers": ["repository-assistant[bot]"],
    },
    {
      "description": "Minor and patch-level updates with usually no breaking changes",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      // most compromised releases are detected within days; npm packages can be unpublished within 72 hours
      "minimumReleaseAge": "3 days",
      "assignees": ["busybeaver"],
      "reviewers": ["repository-assistant[bot]"],
    },
    {
      "description": "Major updates with potentially breaking changes",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "5 days",
      "assignees": ["busybeaver"],
      "reviewers": ["busybeaver"],
      "addLabels": ["major-update"],
    },
    {
      "groupName": "shared-workflows",
      "matchPackageNames": [
        "/^busybeaver/homelab-shared/"
      ]
    }
  ],
}
